def merge_sort(arr):
    n = len(arr)
    mid =n//2
    left = merge_sort(arr[:mid+1])
    right = merge_sort(arr[mid+1:])
    ans=[]
    i,j = 0,0
    while i<len(left) and j<len(right):
        if left[i]<=right[j]:
            ans.append(left[i])
            i+=1
        else:
            ans.append(right[j])
            j+=1
    ans.append(left[i:])
    ans.append(right[j:])
    return arr

